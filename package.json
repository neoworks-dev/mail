{
	"name": "neoworks-mail",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"author": {
		"name": "Moritz Utcke"
	},
	"scripts": {
		"build": "bun build.mjs",
		"dev": "bun build.mjs --watch --host target/release/neomail",
		"host": "bash scripts/host.sh",
		"start": "bun build.mjs && target/release/neomail --bundle dist/neomail.js",
		"sidecar": "bun sidecar/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json && svelte-check --tsconfig ./tsconfig.ui.json --threshold error",
		"test": "bun test tests",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@huggingface/transformers": "^4.2.0",
		"@neoworks/extension-system": "link:@neoworks/extension-system",
		"@neoworks/svelte-gpui": "link:@neoworks/svelte-gpui",
		"@phosphor-icons/core": "^2.1.1",
		"htmlparser2": "^10.0.0",
		"imapflow": "^1.0.191",
		"mailparser": "^3.7.4",
		"marked": "^18.0.7",
		"nodemailer": "^9.0.3",
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/mailparser": "^3.4.6",
		"@types/nodemailer": "^8.0.1",
		"esbuild": "^0.24.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte-check": "^4.7.7",
		"typescript": "^5.9.3"
	},
	"trustedDependencies": [
		"onnxruntime-node",
		"protobufjs"
	]
}
