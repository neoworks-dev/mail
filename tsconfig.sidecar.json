{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"lib": ["ES2022"],
		"types": ["bun"]
	},
	"include": ["sidecar", "shared", "tests"],
	"exclude": ["sidecar/nib/resources"]
}
