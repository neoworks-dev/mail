	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"lib": ["ES2022"],
		"types": [],
		"paths": {
			"@neoworks/svelte-gpui-ui": ["./node_modules/@neoworks/svelte-gpui/packages/svelte-gpui-ui/src/index.ts"]
		}
	},
	"include": ["ui", "shared"]
}
